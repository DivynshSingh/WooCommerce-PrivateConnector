# ==============================================================================
# WooCommerce MCP Server - Environment Configuration
# ==============================================================================

# WooCommerce Store REST API Configuration
WOOCOMMERCE_STORE_URL="https://your-store.example.com"
WOOCOMMERCE_CONSUMER_KEY="ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WOOCOMMERCE_CONSUMER_SECRET="cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OAuth 2.0 / 2.1 Authorization Server (Auth0)
OAUTH_AUTH_SERVER_URL="https://your-tenant.us.auth0.com"
# Optional overrides (JWKS URL and Issuer are automatically derived from OAUTH_AUTH_SERVER_URL if omitted;
# Audience automatically derives from the Worker's own origin URL if omitted):
OAUTH_AUDIENCE="https://your-worker-subdomain.workers.dev"
OAUTH_JWKS_CACHE_TTL_SECONDS=300

# Dual-Layer Rate Limiting Policy
# Authenticated client limit (keyed by token subject)
MCP_RATE_LIMIT_MAX_REQUESTS=50
MCP_RATE_LIMIT_WINDOW_SECONDS=10
# Unauthenticated IP limit (keyed by client IP for discovery & handshakes)
UNAUTH_RATE_LIMIT_MAX_REQUESTS=20
UNAUTH_RATE_LIMIT_WINDOW_SECONDS=60

# WooCommerce API Request Resilience
WOOCOMMERCE_MAX_RETRIES=3
WOOCOMMERCE_TIMEOUT_SECONDS=15
